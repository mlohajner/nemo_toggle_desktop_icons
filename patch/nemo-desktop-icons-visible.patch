 static void
+icons_visible_changed_callback (NemoDesktopIconView *desktop_icon_view)
+{
+    NemoIconContainer *icon_container;
+    NemoDirectory *directory;
+
+    icon_container = get_icon_container (desktop_icon_view);
+
+    if (g_settings_get_boolean (nemo_desktop_preferences, NEMO_PREFERENCES_ICONS_VISIBLE)) {
+        /* add_file() silently skipped every file while hidden, so the
+         * container has nothing to show. Rather than rely on force_reload
+         * (which only re-emits "files_added" for files NemoDirectory
+         * considers new/changed -- not reliable on a second toggle), walk
+         * the directory's already-known file list and call the add_file
+         * vfunc directly for each one, same as the initial load path. */
+        directory = nemo_view_get_model (NEMO_VIEW (desktop_icon_view));
+        if (directory != NULL) {
+            GList *files, *node;
+            files = nemo_directory_get_file_list (directory);
+            for (node = files; node != NULL; node = node->next) {
+                NEMO_VIEW_GET_CLASS (desktop_icon_view)->add_file (
+                    NEMO_VIEW (desktop_icon_view), NEMO_FILE (node->data), directory);
+            }
+            nemo_file_list_free (files);
+        }
+    } else {
+        nemo_icon_container_clear (icon_container);
+    }
+}
